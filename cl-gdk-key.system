(in-package "CL-USER")

(defvar *cl-gdk-key-source-dir*
  (merge-pathnames "cl-gdk-key/" (translate-logical-pathname "PROJECTS:")))
(defvar *cl-gdk-key-binary-dir* (binary-directory *cl-gdk-key-source-dir*))

(mk:defsystem :cl-gdk-key
   :source-pathname *cl-gdk-key-source-dir*
   :binary-pathname *cl-gdk-key-binary-dir*
   :source-extension "lisp"
   :components (
		"package"
		"gdkkeyuni"
		"gdkkeys"
               ))

#+nil
(mk:oos :cl-gdk-key :load :compile-during-load t)
